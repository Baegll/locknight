---
import type { Page } from "../layouts/Portfolio.astro"
import ThemeIcons from "./ThemeIcons.astro"

interface Props {
  page: Page
}

const { page } = Astro.props
// The home page swaps its about/contact sections in place, so its nav carries
// `data-page` hooks and an extra About entry.
const isHome = page === "home"

const icons: Record<string, string[]> = {
  home: [
    "M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-4 0a1 1 0 01-1-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 01-1 1h-2z",
  ],
  projects: [
    "M3 7h18M6 7V5a2 2 0 012-2h8a2 2 0 012 2v2m-1 0v12a2 2 0 01-2 2H7a2 2 0 01-2-2V7h14z",
  ],
  blog: [
    "M19 21H8a2 2 0 01-2-2V5a2 2 0 012-2h11a2 2 0 012 2v14a2 2 0 01-2 2z",
    "M16 3v4H8",
  ],
  about: ["M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"],
  contact: [
    "M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z",
  ],
}

const links = [
  { href: "/", page: "home", label: "Home" },
  { href: "/projects/", page: "projects", label: "Projects" },
  { href: "/blog/", page: "blog", label: "Blog" },
  ...(isHome ? [{ href: "/#about", page: "about", label: "About" }] : []),
  { href: "/#contact", page: "contact", label: "Contact" },
]
---

<nav class="mobile-nav" id={isHome ? "mobile-nav" : undefined} aria-label="Mobile">
  {
    links.map((link) => (
      <a
        class={link.page === page ? "active" : undefined}
        data-page={isHome ? link.page : undefined}
        href={link.href}
        aria-current={link.page === page ? "page" : undefined}
      >
        <svg
          width="18"
          height="18"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
        >
          {icons[link.page].map((d) => (
            <path stroke-linecap="round" stroke-linejoin="round" d={d} />
          ))}
        </svg>
        {link.label}
      </a>
    ))
  }
  <button onclick="toggleTheme()" aria-label="Toggle theme">
    <ThemeIcons size={18} />
    Theme
  </button>
</nav>
