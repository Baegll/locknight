      <div class="contact-left">
        <p class="contact-label">Get in touch</p>
        <h2 class="contact-headline">Let's work<br>together.</h2>
        <p class="contact-sub">Have a project in mind or just want to chat? Reach out - I'm always happy to connect.</p>
        <a id="email-link" href="mailto:nat.johanek@gmail.com" class="cta-btn">
          <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
          <span id="email-text">Say Hello</span>
        </a>
      </div>
      <div class="contact-right">
        <a href="https://github.com/Baegll" target="_blank" rel="noopener noreferrer" class="contact-link">
          <svg width="16" height="16" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
          GitHub
          <svg style="margin-left:auto" width="12" height="12" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
        </a>
        <a href="https://www.linkedin.com/in/natlj/" target="_blank" rel="noopener noreferrer" class="contact-link">
          <svg width="16" height="16" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
          LinkedIn
          <svg style="margin-left:auto" width="12" height="12" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
        </a>
        <a href="/blog/" class="contact-link" style="border-bottom:none">
          <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/></svg>
          Blog
          <svg style="margin-left:auto" width="12" height="12" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
        </a>
      </div>
    </div>
  </div>

  <Fragment slot="after-main">
    <script is:inline>
      var currentPage = "home";
      var pages = ["home", "about", "contact"];
      var pathMap = { home: "/ index", about: "/#about", contact: "/#contact" };

      function applyPageState(page, updateHash) {
        if (pages.indexOf(page) === -1) {
          page = "home";
        }

        currentPage = page;

        document.querySelectorAll(".page-section").forEach(function(el) {
          el.classList.remove("active");
        });

        var target = document.getElementById("page-" + page);
        if (target) target.classList.add("active");

        document.querySelectorAll(".sidebar-link").forEach(function(el) {
          var isActive = el.getAttribute("data-page") === page;
          el.classList.toggle("active", isActive);
          if (isActive) {
            el.setAttribute("aria-current", "page");
          } else {
            el.removeAttribute("aria-current");
          }
        });

        document.querySelectorAll(".mobile-nav a[data-page]").forEach(function(el) {
          var isActive = el.getAttribute("data-page") === page;
          el.classList.toggle("active", isActive);
          if (isActive) {
            el.setAttribute("aria-current", "page");
          } else {
            el.removeAttribute("aria-current");
          }
        });

        var strip = document.getElementById("strip-path");
        if (strip) strip.textContent = pathMap[page] || "/ " + page;

        if (updateHash) {
          var hash = page === "home" ? "" : "#" + page;
          history.replaceState(null, "", window.location.pathname + hash);
        }

        var main = document.getElementById("main");
        if (main) main.scrollTo({ top: 0 });
        window.scrollTo({ top: 0 });
      }

      function syncPageFromLocation() {
        var page = window.location.hash.replace("#", "") || "home";
        applyPageState(page, false);
      }

      document.querySelectorAll("a[data-page]").forEach(function(el) {
        el.addEventListener("click", function(event) {
          var href = el.getAttribute("href") || "";
          if (href.charAt(0) !== "#" && href.indexOf("/#") === -1) return;
          event.preventDefault();
          applyPageState(el.getAttribute("data-page") || "home", true);
        });
      });

      window.addEventListener("hashchange", syncPageFromLocation);
      syncPageFromLocation();
    </script>
  </Fragment>
</Portfolio>
