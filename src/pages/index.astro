---
import Portfolio from "../layouts/Portfolio.astro"
---

<Portfolio
  title="Natalie Johanek - SDE2"
  description="Natalie Johanek - SDE2 building distributed systems. Focused on low-latency APIs, developer tooling, and system observability."
  page="home"
  stripPath="/ index"
>
  <div class="page-section active" id="page-home">
    <div class="hero">
      <div>
        <div style="margin-bottom:32px">
          <span class="hero-role">SDE2</span>
        </div>
        <h1 class="hero-name">
          Natalie<br>
          <span class="accent">Johanek</span><span style="color:var(--t-cta);font-family:var(--t-font-code,'IBM Plex Mono',monospace);font-size:0.15em;vertical-align:super;letter-spacing:0"></span>
        </h1>
      </div>
      <div class="hero-right">
        <img src="/assets/headshot.jpg" alt="Natalie Johanek" class="hero-photo">
        <p class="hero-desc">
          Building distributed systems at Amazon. Focused on low-latency APIs, developer tooling, and system observability.
        </p>
        <div style="display:flex;gap:12px;flex-wrap:wrap">
          <a href="/projects/" class="cta-btn" style="margin-top:0;padding:10px 20px;font-size:13px">
            View Work
            <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
          </a>
          <a class="btn-outline" href="/#contact">Contact</a>
        </div>
      </div>
    </div>

    <div class="keyword-strip">
      <span>Distributed Systems</span>
      <span><span class="kw-dot"></span>Low-latency APIs</span>
      <span><span class="kw-dot"></span>Developer Tooling</span>
      <span><span class="kw-dot"></span>System Observability</span>
      <span><span class="kw-dot"></span>Customer Experience</span>
    </div>

    <div class="info-grid">
      <div class="info-cell">
        <div class="info-label">Current role</div>
        <div class="info-value">SDE2 - Amazon</div>
      </div>
      <div class="info-cell">
        <div class="info-label">Location</div>
        <div class="info-value">Austin, United States</div>
      </div>
      <div class="info-cell">
        <div class="info-label">Focus area</div>
        <div class="info-value">Distributed Systems</div>
      </div>
      <div class="info-cell">
        <div class="info-label">Outside work</div>
        <div class="info-value">Fencing Coach</div>
      </div>
    </div>

    <div class="section-header">
      <span class="section-title">Latest Writing</span>
      <a href="/blog/" class="section-link">All posts -></a>
    </div>
    <a href="/blog/context-management" class="blog-row">
      <div>
        <div class="blog-title">Context Management: Getting Better Responses from AI</div>
        <div class="blog-excerpt">Practical techniques for managing context windows when working with large language models.</div>
      </div>
      <div class="blog-date">Apr 2026</div>
    </a>
    <div class="blog-row-wrap">
      <a href="/blog/tournament-design-and-incentives" class="blog-row">
        <div>
          <div class="blog-title">Tournament Design and Incentives</div>
          <div class="blog-excerpt">Exploring the principles of creating engaging and fair competitive tournaments.</div>
        </div>
        <div class="blog-date">Apr 2026</div>
      </a>
      <a href="https://github.com/Baegll/HemaScoreCardScripts" class="blog-project" target="_blank" rel="noopener">
        <span class="blog-project-label">project -></span>
        <span class="blog-project-name">HEMA Scorecard Scripts</span>
        <div class="blog-project-tags">
          <span class="tag">Python</span>
          <span class="tag">Data Analysis</span>
          <span class="tag">HEMA</span>
        </div>
        <span class="blog-project-arrow">-></span>
      </a>
    </div>
  </div>

  <div class="page-section" id="page-about">
    <div class="about-grid">
      <div class="about-left">
        <img src="/assets/headshot.jpg" alt="Natalie Johanek" class="about-photo">
        <p class="about-label">About</p>
        <h2 class="about-heading">A bit<br>about me.</h2>
        <p class="about-body" style="margin-bottom:16px">
          I'm an SDE2 at Amazon working on distributed systems for last-mile delivery. I build low-latency APIs under strict SLAs, architect data pipelines, and care deeply about developer tooling and system observability.
        </p>
        <p class="about-body">
          Outside of work, I coach competitive fencing, run tournament operations, and write about software. I studied Computer Science at the University of North Texas with a minor in Mathematics.
        </p>
      </div>
      <div class="about-right">
        <div style="padding-top:40px">
          <div class="fact-row">
            <span class="fact-label">Employer</span>
            <span class="fact-value">Amazon</span>
          </div>
          <div class="fact-row">
            <span class="fact-label">Role</span>
            <span class="fact-value">SDE2</span>
          </div>
          <div class="fact-row">
            <span class="fact-label">Domain</span>
            <span class="fact-value">Distributed Systems</span>
          </div>
          <div class="fact-row">
            <span class="fact-label">Education</span>
            <span class="fact-value">CS + Math - UNT</span>
          </div>
          <div class="fact-row">
            <span class="fact-label">Outside work</span>
            <span class="fact-value">Fencing Coach &amp; TO</span>
          </div>
          <div class="fact-row">
            <span class="fact-label">Currently reading</span>
            <span class="fact-value">Designing Data-Intensive Apps</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="page-section" id="page-contact">
